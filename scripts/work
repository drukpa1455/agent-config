#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)
fallback="$root/skills/implement/scripts/work"

case ${1:-} in
  new)
    exec "$fallback" "$@"
    ;;
  done)
    [ "$#" -eq 1 ] || { echo "usage: work new <task> | work done" >&2; exit 1; }
    unset WORK_PRIMARY_UPDATER
    primary=$("$fallback" done)
    cd "$primary"
    if ! "$primary/scripts/link"; then
      echo "work: task cleaned; configuration installation pending: $primary/scripts/link" >&2
      exit 1
    fi
    printf '%s\n' "$primary"
    ;;
  *)
    echo "usage: work new <task> | work done" >&2
    exit 1
    ;;
esac
