#!/usr/bin/env python3
"""Link an explicitly selected set of components; never replace foreign files."""

import argparse
import os
from pathlib import Path
import shutil
import sys


ROOT = Path(__file__).resolve().parent.parent


def owned(destination, source):
    return destination.is_symlink() and destination.resolve() == source.resolve()


def writable_parent(destination):
    parent = destination.parent
    while not parent.exists() and not parent.is_symlink():
        parent = parent.parent
    if not parent.is_dir():
        raise ValueError(f"not a directory: {parent}")
    if not os.access(parent, os.W_OK | os.X_OK):
        raise ValueError(f"not writable: {parent}")


def main():
    available = sorted(path.name for path in (ROOT / "skills").iterdir()
                       if (path / "SKILL.md").is_file())
    parser = argparse.ArgumentParser(
        description="Select the complete set to link: policy and/or named skills. "
                    "Omitted components owned by this checkout are unlinked.",
        epilog="Available components: policy, " + ", ".join(available),
    )
    parser.add_argument("--check", action="store_true", help="preview without changing files")
    parser.add_argument("--none", action="store_true", help="unlink all components owned by this checkout")
    parser.add_argument("components", nargs="*", metavar="COMPONENT")
    args = parser.parse_args()
    selected = set(args.components)
    if args.none == bool(selected):
        parser.error("name components to install, or use --none to remove owned links")
    unknown = selected - {"policy", *available}
    if unknown:
        parser.error("unknown components: " + ", ".join(sorted(unknown)))

    harness_path = os.environ.get("AGENT_CONFIG_HARNESS_PATH", os.environ.get("PATH", ""))
    harnesses = {name for name in ("pi", "codex", "claude")
                 if shutil.which(name, path=harness_path)}
    if selected and not harnesses:
        parser.error("no supported harness on PATH (pi, codex, claude)")
    user_dir = Path.home()
    actions = []
    replacing = set()

    def remove(destination, source):
        if owned(destination, source):
            actions.append(("unlink", destination, source))

    def link(destination, source, fresh=False):
        if not source.exists():
            raise ValueError(f"missing source: {source}")
        if not fresh:
            if owned(destination, source):
                return
            if destination.exists() or destination.is_symlink():
                raise ValueError(f"refusing to replace {destination}")
        actions.append(("link", destination, source))

    def skills(destination, names):
        fresh = False
        if destination.is_symlink():
            if owned(destination, ROOT / "skills"):
                remove(destination, ROOT / "skills")
                replacing.add(destination)
                fresh = True
            elif names:
                raise ValueError(f"refusing foreign skills directory link: {destination}")
            else:
                return
        elif destination.exists() and not destination.is_dir():
            if names:
                raise ValueError(f"not a directory: {destination}")
            return
        if not fresh and destination.is_dir():
            for entry in sorted(destination.iterdir()):
                if entry.name not in names:
                    remove(entry, ROOT / "skills" / entry.name)
        for name in sorted(names):
            link(destination / name, ROOT / "skills" / name, fresh)

    names = selected - {"policy"}
    skills(user_dir / ".agents/skills", names if harnesses & {"pi", "codex"} else set())
    skills(user_dir / ".claude/skills", names if "claude" in harnesses else set())
    for harness, relative in (
        ("pi", ".pi/agent/AGENTS.md"),
        ("codex", ".codex/AGENTS.md"),
        ("claude", ".claude/CLAUDE.md"),
    ):
        destination = user_dir / relative
        source = ROOT / "global/AGENTS.md"
        if "policy" in selected and harness in harnesses:
            link(destination, source)
        else:
            remove(destination, source)
    # Retire the old session-wide voice projection; preserve anyone else's file.
    remove(user_dir / ".agents/voice.md", ROOT / "global/voice.md")

    # Validate the whole plan before mutating any destination.
    for _, destination, _ in actions:
        parent_target = destination.parent if destination.parent in replacing else destination
        writable_parent(parent_target)
    for operation, destination, source in actions:
        print(f"{operation} {destination}" + (f" -> {source}" if operation == "link" else ""))
        if args.check:
            continue
        if operation == "unlink":
            if not owned(destination, source):
                raise ValueError(f"destination changed during installation: {destination}")
            destination.unlink()
        else:
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.symlink_to(source)
    if not actions:
        print("selected configuration is already in place")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(f"link: {error}")
