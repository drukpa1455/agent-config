#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
test_home="$temporary/home"
remote="$temporary/remote.git"
seed="$temporary/seed"
primary="$temporary/primary"
active="$temporary/active"
landed="$temporary/landed"
side="$temporary/side"
mkdir -p "$test_home/.agents/skills/foreign" "$seed/scripts" "$seed/global"
printf 'local instructions\n' >"$test_home/.agents/skills/foreign/SKILL.md"

cp "$root/scripts/update" "$seed/scripts/update"
printf '%s\n' '#!/bin/sh' 'touch "$HOME/implicit-install"; exit 99' >"$seed/scripts/link"
chmod +x "$seed/scripts/link"
printf 'version one\n' >"$seed/global/AGENTS.md"
printf 'secret\n' >"$seed/.gitignore"
git init --quiet --initial-branch=main "$seed"
git -C "$seed" config user.email test@example.com
git -C "$seed" config user.name Test
git -C "$seed" add .
git -C "$seed" commit --quiet -m one
git init --quiet --bare --initial-branch=main "$remote"
git -C "$seed" remote add origin "$remote"
git -C "$seed" push --quiet -u origin main
git clone --quiet "$remote" "$primary"
primary=$(CDPATH= cd -- "$primary" && pwd -P)
git -C "$primary" config user.email test@example.com
git -C "$primary" config user.name Test
git -C "$primary" worktree add --quiet --detach "$active" HEAD

ok() {
  printf 'ok   %s\n' "$1"
}

rejects() {
  description=$1
  shift
  if "$@" >"$temporary/out" 2>"$temporary/err"; then
    printf 'not ok   %s\n' "$description" >&2
    exit 1
  fi
  ok "$description"
}

run_update() {
  HOME="$test_home" "$landed/scripts/update"
}

run_primary_update() {
  HOME="$test_home" "$primary/scripts/update"
}

run_timed_update() {
  HOME="$test_home" PATH="$temporary/bin:$PATH" UPDATE_TIMEOUT=0.05 \
    "$landed/scripts/update"
}

old=$(git -C "$primary" rev-parse HEAD)
printf 'version two\n' >"$seed/global/AGENTS.md"
git -C "$seed" commit --quiet -am two
git -C "$seed" push --quiet
git -C "$primary" fetch --quiet origin main
git -C "$primary" worktree add --quiet --detach "$landed" origin/main
mkdir "$temporary/bin"
real_git=$(command -v git)
printf '%s\n' '#!/bin/sh' \
  'case " $* " in *" ls-remote "*) printf "ref: refs/heads/main\tHEAD\n"; sleep 2; exit 0 ;; esac' \
  "exec '$real_git' \"\$@\"" >"$temporary/bin/git"
chmod +x "$temporary/bin/git"
rejects "remote timeouts release the update lock" run_timed_update
for name in agent-config-update.lock agent-primary-update.lock; do
  exec 8>"$primary/.git/$name"
  python3 -c 'import fcntl; fcntl.flock(8, fcntl.LOCK_EX | fcntl.LOCK_NB)'
  exec 8>&-
done
touch "$landed/dirty"
rejects "a dirty invoking worktree preserves the primary" run_update
[ "$(git -C "$primary" rev-parse HEAD)" = "$old" ]
rm "$landed/dirty"
marker="$temporary/hook-ran"
printf '%s\n' '#!/bin/sh' "touch '$marker'" >"$primary/.git/hooks/reference-transaction"
chmod +x "$primary/.git/hooks/reference-transaction"
result=$(run_update)
[ "$result" = "updated agent config to $(git -C "$primary" rev-parse --short HEAD)" ]
[ "$(git -C "$primary" rev-parse HEAD)" = "$(git -C "$seed" rev-parse HEAD)" ]
[ "$(git -C "$active" rev-parse HEAD)" = "$old" ]
[ ! -e "$marker" ]
[ ! -e "$test_home/implicit-install" ]
[ ! -e "$test_home/.codex" ]
[ "$(cat "$test_home/.agents/skills/foreign/SKILL.md")" = "local instructions" ]
ok "a landed invocation fast-forwards without hooks, installation, or home changes"
rm "$primary/.git/hooks/reference-transaction"

mkdir "$test_home/.codex"
ln -s "$primary/global/AGENTS.md" "$test_home/.codex/AGENTS.md"
mkdir -p "$seed/skills/new"
printf '%s\n' '---' 'name: new' '---' >"$seed/skills/new/SKILL.md"
printf 'version three\n' >"$seed/global/AGENTS.md"
git -C "$seed" add .
git -C "$seed" commit --quiet -m three
git -C "$seed" push --quiet
before=$(git -C "$primary" rev-parse HEAD)
run_update >/dev/null
[ "$(git -C "$primary" rev-parse HEAD)" = "$before" ]
ok "a landed invocation does not advance to newer remote changes"
run_primary_update >/dev/null
[ "$(cat "$test_home/.codex/AGENTS.md")" = "version three" ]
[ ! -e "$test_home/.agents/skills/new" ]
[ ! -e "$test_home/implicit-install" ]
ok "existing symlinks reflect updated content without installing new components"

git -C "$seed" switch --quiet -c side
git -C "$seed" commit --quiet --allow-empty -m side
side_head=$(git -C "$seed" rev-parse HEAD)
git -C "$seed" switch --quiet main
git -C "$seed" merge --quiet --no-ff side -m merge
git -C "$seed" push --quiet
git -C "$primary" fetch --quiet origin main
git -C "$primary" worktree add --quiet --detach "$side" "$side_head"
rejects "a merged side-branch revision cannot become primary trunk" \
  env HOME="$test_home" "$side/scripts/update"
git -C "$primary" merge --quiet --ff-only "$side_head"
rejects "a side-branch primary is not treated as trunk" run_primary_update
git -C "$primary" merge --quiet --ff-only origin/main

for name in agent-config-update.lock agent-primary-update.lock; do
  exec 8>"$primary/.git/$name"
  python3 -c 'import fcntl; fcntl.flock(8, fcntl.LOCK_EX | fcntl.LOCK_NB)'
  rejects "an active update lock preserves the primary" run_update
  exec 8>&-
done
run_update >/dev/null
ok "a released update lock is immediately reusable"

printf 'private\n' >"$primary/private"
rejects "untracked work preserves the primary" run_update
rm "$primary/private"
printf 'ignored\n' >"$primary/secret"
rejects "ignored work preserves the primary" run_update
rm "$primary/secret"
git -C "$primary" switch --quiet -c feature
rejects "a non-trunk primary is preserved" run_update
git -C "$primary" switch --quiet main

git -C "$primary" commit --quiet --allow-empty -m ahead
rejects "primary commits absent from origin are preserved" run_primary_update
git -C "$primary" push --quiet origin main
git -C "$seed" pull --quiet --ff-only

git -C "$seed" commit --quiet --allow-empty -m four
git -C "$seed" push --quiet
before=$(git -C "$primary" rev-parse HEAD)
run_update >/dev/null
[ "$(git -C "$primary" rev-parse HEAD)" = "$before" ]
ok "an older invocation does not rewind a newer clean primary"

git -C "$primary" commit --quiet --allow-empty -m local
rejects "a landed invocation rejects an unlanded primary" run_update
rejects "diverged primary history is preserved" run_primary_update

printf 'all checks passed\n'
