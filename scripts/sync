#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
policy="$root/global/AGENTS.md"

[ "$#" -gt 0 ] || {
  echo "usage: scripts/sync REPOSITORY..." >&2
  exit 2
}

for target do
  repository=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null) || {
    echo "not a git repository: $target" >&2
    exit 1
  }
  target=$(CDPATH= cd -- "$target" && pwd -P)
  repository=$(CDPATH= cd -- "$repository" && pwd -P)
  [ "$target" = "$repository" ] || {
    echo "not a repository root: $target" >&2
    exit 1
  }
  [ ! -L "$repository/AGENTS.md" ] || {
    echo "refusing a symbolic link: $repository/AGENTS.md" >&2
    exit 1
  }
  [ ! -e "$repository/AGENTS.md" ] || [ -f "$repository/AGENTS.md" ] || {
    echo "not a regular file: $repository/AGENTS.md" >&2
    exit 1
  }
  cp "$policy" "$repository/AGENTS.md"
  echo "synced $repository/AGENTS.md"
done
