#!/usr/bin/env python3
"""Exercise installation in disposable homes; never touch the caller's config."""

import os
from pathlib import Path
import subprocess
import tempfile
import unittest


ROOT = Path(__file__).resolve().parent.parent


class LinkTests(unittest.TestCase):
    def setUp(self):
        scratch = tempfile.TemporaryDirectory(prefix="agent-config-link-")
        self.addCleanup(scratch.cleanup)
        self.scratch = Path(scratch.name)
        self.test_home = self.scratch / "home"
        self.test_home.mkdir()
        self.bin_dir = self.scratch / "bin"
        self.bin_dir.mkdir()
        self.enable("pi", "codex", "claude")

    def enable(self, *names):
        for executable in self.bin_dir.iterdir():
            executable.unlink()
        for name in names:
            executable = self.bin_dir / name
            executable.write_text("#!/bin/sh\nexit 0\n")
            executable.chmod(0o755)

    def run_link(self, *args, succeeds=True):
        result = subprocess.run(
            [str(ROOT / "scripts/link"), *args],
            env={**os.environ, "HOME": str(self.test_home),
                 "AGENT_CONFIG_HARNESS_PATH": str(self.bin_dir)},
            capture_output=True, text=True, timeout=10,
        )
        self.assertEqual(result.returncode == 0, succeeds, result.stdout + result.stderr)
        return result

    def put(self, name, content="foreign"):
        destination = self.test_home / name
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(content)
        return destination

    def symlink(self, name, target):
        destination = self.test_home / name
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.symlink_to(target)
        return destination

    def snapshot(self):
        return [(str(path.relative_to(self.test_home)),
                 os.readlink(path) if path.is_symlink() else
                 path.read_bytes() if path.is_file() else None)
                for path in sorted(self.test_home.rglob("*"))]

    def assert_link(self, name, source):
        self.assertEqual(os.readlink(self.test_home / name), str(ROOT / source))

    def test_explicit_selection_required(self):
        for args in ((), ("--check",), ("--none", "wiki"), ("typo",), ("../wiki",)):
            self.run_link(*args, succeeds=False)
        self.assertEqual(self.snapshot(), [])

    def test_check_does_not_create_directories(self):
        result = self.run_link("--check", "policy", "wiki")
        self.assertIn(".codex/AGENTS.md", result.stdout)
        self.assertEqual(self.snapshot(), [])

    def test_policy_only_and_idempotence(self):
        self.run_link("policy")
        for name in (".pi/agent/AGENTS.md", ".codex/AGENTS.md", ".claude/CLAUDE.md"):
            self.assert_link(name, "global/AGENTS.md")
        self.assertFalse((self.test_home / ".agents/skills").exists())
        self.assertFalse((self.test_home / ".agents/voice.md").exists())
        before = self.snapshot()
        self.run_link("policy")
        self.assertEqual(self.snapshot(), before)

    def test_skills_without_policy(self):
        self.run_link("wiki", "lens")
        for directory in (".agents/skills", ".claude/skills"):
            self.assertEqual(sorted(path.name for path in (self.test_home / directory).iterdir()),
                             ["lens", "wiki"])
            self.assert_link(f"{directory}/wiki", "skills/wiki")
        self.assertFalse((self.test_home / ".codex/AGENTS.md").exists())

    def test_selection_replaces_owned_set(self):
        self.run_link("policy", "wiki", "lens")
        self.run_link("browse")
        for directory in (".agents/skills", ".claude/skills"):
            self.assertEqual([path.name for path in (self.test_home / directory).iterdir()], ["browse"])
        self.assertFalse((self.test_home / ".codex/AGENTS.md").is_symlink())

    def test_host_skills_and_foreign_policy_survive(self):
        self.symlink(".agents/skills/omarchy", "/usr/share/omarchy/default/agents/skills/omarchy")
        self.symlink(".claude/skills/diagnose-crash", "/unavailable/diagnose-crash")
        foreign = self.put(".claude/skills/custom/SKILL.md")
        policy = self.put(".codex/AGENTS.md")
        self.run_link("wiki")
        self.run_link("--none")
        self.assertEqual(os.readlink(self.test_home / ".agents/skills/omarchy"),
                         "/usr/share/omarchy/default/agents/skills/omarchy")
        self.assertEqual(os.readlink(self.test_home / ".claude/skills/diagnose-crash"),
                         "/unavailable/diagnose-crash")
        self.assertEqual(foreign.read_text(), "foreign")
        self.assertEqual(policy.read_text(), "foreign")
        self.assertFalse((self.test_home / ".agents/skills/wiki").is_symlink())

    def test_unselected_name_collision_is_harmless(self):
        foreign = self.put(".agents/skills/lens/SKILL.md")
        self.run_link("wiki")
        self.assertEqual(foreign.read_text(), "foreign")

    def test_selected_collision_rejected_before_any_mutation(self):
        self.put(".claude/skills/wiki/SKILL.md")
        before = self.snapshot()
        self.run_link("--check", "policy", "wiki", succeeds=False)
        self.run_link("policy", "wiki", succeeds=False)
        self.assertEqual(self.snapshot(), before)

    def test_policy_collision_does_not_partially_install_skills(self):
        self.put(".claude/CLAUDE.md")
        before = self.snapshot()
        self.run_link("policy", "wiki", succeeds=False)
        self.assertEqual(self.snapshot(), before)

    def test_broken_foreign_link_collision(self):
        self.symlink(".agents/skills/wiki", "/unavailable/wiki")
        before = self.snapshot()
        self.run_link("wiki", succeeds=False)
        self.assertEqual(self.snapshot(), before)

    def test_non_directory_parent(self):
        self.put(".codex")
        before = self.snapshot()
        self.run_link("policy", "wiki", succeeds=False)
        self.assertEqual(self.snapshot(), before)

    @unittest.skipIf(os.geteuid() == 0, "root bypasses directory write permissions")
    def test_unwritable_parent(self):
        parent = self.test_home / ".codex"
        parent.mkdir(mode=0o555)
        self.addCleanup(parent.chmod, 0o755)
        before = self.snapshot()
        self.run_link("--check", "policy", "wiki", succeeds=False)
        self.run_link("policy", "wiki", succeeds=False)
        self.assertEqual(self.snapshot(), before)

    def test_installs_only_available_harnesses(self):
        self.enable("codex")
        self.run_link("policy", "wiki")
        self.assert_link(".codex/AGENTS.md", "global/AGENTS.md")
        self.assert_link(".agents/skills/wiki", "skills/wiki")
        self.assertFalse((self.test_home / ".pi").exists())
        self.assertFalse((self.test_home / ".claude").exists())
        self.enable("claude")
        self.run_link("policy", "wiki")
        self.assert_link(".claude/CLAUDE.md", "global/AGENTS.md")
        self.assert_link(".claude/skills/wiki", "skills/wiki")
        self.assertFalse((self.test_home / ".codex/AGENTS.md").is_symlink())
        self.assertFalse((self.test_home / ".agents/skills/wiki").is_symlink())

    def test_no_harness_requires_explicit_uninstall(self):
        self.run_link("policy", "wiki")
        self.enable()
        before = self.snapshot()
        self.run_link("wiki", succeeds=False)
        self.assertEqual(self.snapshot(), before)
        self.run_link("--none")
        self.assertFalse(any(path.is_symlink() for path in self.test_home.rglob("*")))

    def test_retires_owned_old_skills_and_voice(self):
        for directory in (".agents/skills", ".claude/skills"):
            for name in ("implement", "debug", "retired"):
                self.symlink(f"{directory}/{name}", ROOT / "skills" / name)
        self.symlink(".agents/voice.md", ROOT / "global/voice.md")
        self.run_link("wiki")
        self.assertFalse((self.test_home / ".agents/voice.md").is_symlink())
        for directory in (".agents/skills", ".claude/skills"):
            self.assertEqual([path.name for path in (self.test_home / directory).iterdir()], ["wiki"])

    def test_foreign_voice_preserved(self):
        voice = self.put(".agents/voice.md", "personal voice")
        self.run_link("policy")
        self.assertEqual(voice.read_text(), "personal voice")

    def test_legacy_directory_link_converted_to_selected_entries(self):
        directory = self.symlink(".agents/skills", ROOT / "skills")
        self.run_link("--check", "wiki")
        self.assertTrue(directory.is_symlink())
        self.run_link("wiki")
        self.assertFalse(directory.is_symlink())
        self.assertEqual([path.name for path in directory.iterdir()], ["wiki"])
        self.assert_link(".agents/skills/wiki", "skills/wiki")

    def test_legacy_link_unchanged_when_other_destination_conflicts(self):
        self.symlink(".agents/skills", ROOT / "skills")
        self.put(".claude/CLAUDE.md")
        before = self.snapshot()
        self.run_link("policy", "wiki", succeeds=False)
        self.assertEqual(self.snapshot(), before)

    def test_foreign_directory_link_is_preserved(self):
        destination = self.symlink(".agents/skills", self.scratch)
        self.run_link("wiki", succeeds=False)
        self.run_link("--none")
        self.assertTrue(destination.is_symlink())

    def test_logical_and_relative_owned_links(self):
        alias = self.scratch / "source"
        alias.symlink_to(ROOT)
        policy = self.symlink(".codex/AGENTS.md", "../../source/global/AGENTS.md")
        self.symlink(".agents/skills/wiki", alias / "skills/wiki")
        retired = self.symlink(".agents/skills/retired", alias / "skills/retired")
        self.run_link("policy", "wiki")
        self.assertEqual(os.readlink(policy), "../../source/global/AGENTS.md")
        self.assertFalse(retired.is_symlink())


if __name__ == "__main__":
    unittest.main(verbosity=2)
