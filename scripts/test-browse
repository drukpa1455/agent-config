#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
core="$temporary/node_modules/patchright-core"
mkdir -p "$core/lib/tools/cli-client"
printf '%s\n' '{"version":"test"}' >"$core/package.json"
cat >"$core/lib/tools/cli-client/program.js" <<'JS'
exports.program = async options => {
  console.log(JSON.stringify({ args: process.argv.slice(2), options }));
  if (process.env.BROWSE_TEST_FAIL) throw new Error('native failure');
};
JS
adapter="$root/skills/browse/scripts/patchright"
PERSISTENT_BROWSER_RUNTIME="$temporary" "$adapter" -s=example open 'https://example.com/a b' --headed >"$temporary/result"
node - "$temporary/result" <<'JS'
const assert = require('node:assert/strict');
const fs = require('node:fs');
assert.deepEqual(JSON.parse(fs.readFileSync(process.argv[2])), {
  args: ['-s=example', 'open', 'https://example.com/a b', '--headed'],
  options: { embedderVersion: 'test' },
});
JS
if BROWSE_TEST_FAIL=1 PERSISTENT_BROWSER_RUNTIME="$temporary" "$adapter" close >"$temporary/result" 2>"$temporary/error"; then
  echo 'native failures must fail the adapter' >&2; exit 1
fi
rg -q '^native failure$' "$temporary/error"
if PERSISTENT_BROWSER_RUNTIME="$temporary/missing" "$adapter" --help >"$temporary/result" 2>"$temporary/error"; then
  echo 'missing runtime must fail the adapter' >&2; exit 1
fi
rg -q 'read references/setup.md' "$temporary/error"
printf 'all checks passed\n'
